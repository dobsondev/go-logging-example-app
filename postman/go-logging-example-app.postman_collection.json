{
	"info": {
		"_postman_id": "7030c48e-cbd9-469f-8aca-56be1d90fa26",
		"name": "Go Logging Example App",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "35117207"
	},
	"item": [
		{
			"name": "HealthCheck",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Your test name\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(\"ok\");",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{scheme}}://{{url}}/health",
					"protocol": "{{scheme}}",
					"host": [
						"{{url}}"
					],
					"path": [
						"health"
					]
				}
			},
			"response": []
		},
		{
			"name": "ErrorLogger",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const count = pm.variables.get(\"count\");",
							"",
							"pm.test(\"Response is JSON\", function () {",
							"    pm.response.to.have.header(\"Content-Type\", \"application/json\");",
							"});",
							"",
							"pm.test(\"Status field is ok\", function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.status).to.eql(\"ok\");",
							"});",
							"",
							"pm.test(\"Message matches expected format\", function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.message).to.eql(`${count} errors written to logs`);",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const count = Math.floor(Math.random() * 10) + 1;",
							"pm.variables.set(\"count\", count);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{scheme}}://{{url}}/errors/{{count}}",
					"protocol": "{{scheme}}",
					"host": [
						"{{url}}"
					],
					"path": [
						"errors",
						"{{count}}"
					]
				}
			},
			"response": []
		}
	]
}